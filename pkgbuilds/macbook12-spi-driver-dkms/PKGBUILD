# DevOS fork of the AUR `macbook12-spi-driver-dkms` PKGBUILD.
#
# WHY A FORK: the upstream driver predates several kernel changes and no longer
# compiles on linux-lts >= 6.12 (the kernel DevOS ships). Two breakages in
# applespi.c, plus the bundled apple-ib-* modules duplicate apple-ib-drv:
#
#   1. kernel 6.12 removed the <asm/unaligned.h> wrapper -> use <linux/unaligned.h>
#   2. kernel 6.12 removed `no_llseek` -> drop `.llseek = no_llseek,` (the default
#      seek behaviour is now equivalent for a misc device)
#   3. the bundled apple-ibridge/apple-ib-tb/apple-ib-als are an OLD copy of the
#      Touch Bar / ALS drivers. They (a) fail on kernel >= 6.11 (platform_driver
#      .remove now returns void, not int) and (b) collide with apple-ib-drv-dkms-git
#      on apple-ibridge.ko. apple-ib-drv is the maintained split-out and builds
#      cleanly, so we build ONLY applespi here (keyboard + trackpad).
#
# prepare() applies (1) and (2) and trims the Makefile to applespi; the shipped
# dkms.conf builds only applespi. Everything else matches the AUR recipe.
#
# Built by devos/tools/build-aur-repo.sh via the `local:pkgbuilds/macbook12-spi-driver-dkms`
# entry in aur-build-list.txt. On the next kernel bump, re-verify the two patches
# still apply (a test compile against /usr/lib/modules/<kver>/build is enough).
#
# Maintainer: Christoph Gysin <christoph.gysin@gmail.com>   (original AUR recipe)
# Maintainer: Andrey Melentyev <andrey.melentyev@protonmail.com>
_pkgbase=macbook12-spi-driver
pkgname=(${_pkgbase}-dkms)
pkgver=0+git.315
pkgrel=2
pkgdesc="Driver for the SPI keyboard and trackpad on 2015-2017 MacBook (Pro) (DevOS build: applespi only, patched for kernel >=6.12)"
arch=('i686' 'x86_64')
url="https://github.com/marc-git/macbook12-spi-driver"
license=('GPL2')
depends=('dkms')
makedepends=('git')
optdepends=()
source=(git+https://github.com/marc-git/macbook12-spi-driver.git#branch=touchbar-driver-hid-driver
        dkms.conf)
sha256sums=('SKIP'
            'SKIP')

pkgver() {
    cd $_pkgbase
    echo "0+git.$(git rev-list HEAD --count)"
}

prepare() {
    cd "$srcdir/$_pkgbase"

    # (1) kernel 6.12: <asm/unaligned.h> wrapper removed.
    sed -i 's|#include <asm/unaligned.h>|#include <linux/unaligned.h>|' applespi.c

    # (2) kernel 6.12: no_llseek removed. Dropping the assignment leaves the
    #     default, which is equivalent for this misc device.
    sed -i '/\.llseek[[:space:]]*=[[:space:]]*no_llseek,/d' applespi.c

    # (3) Build ONLY applespi. DKMS runs the Makefile (which has obj-m for all
    #     four modules), so drop the apple-ib-* targets here too — they are an
    #     old copy of the Touch Bar / ALS drivers, fail on kernel >= 6.11, and
    #     duplicate apple-ib-drv-dkms-git (apple-ibridge.ko / apple-touchbar.ko).
    sed -i '/^obj-m += apple-ib/d' Makefile

    msg2 "DevOS: patched applespi for kernel >=6.12 and trimmed build to applespi only."
}

package() {
    install -dm755 "${pkgdir}"/usr/src/${_pkgbase}-${pkgver}

    # Copy sources (including Makefile)
    cp -r ${_pkgbase}/* "${pkgdir}"/usr/src/${_pkgbase}-${pkgver}/

    # Copy dkms.conf over the original one from the repo
    install -Dm644 dkms.conf "${pkgdir}"/usr/src/${_pkgbase}-${pkgver}/dkms.conf

    # Set name and version
    sed -e "s/@_PKGBASE@/${_pkgbase}/" \
        -e "s/@PKGVER@/${pkgver}/" \
        -i "${pkgdir}"/usr/src/${_pkgbase}-${pkgver}/dkms.conf
}
