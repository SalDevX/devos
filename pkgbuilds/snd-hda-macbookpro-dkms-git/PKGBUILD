# DevOS fork of the AUR `snd-hda-macbookpro-dkms-git` (davidjo CS8409 audio driver).
#
# WHY A FORK: on the 2016/2017 MacBook Pro the Cirrus CS8409 codec needs Apple's
# external speaker amps (MAX98706/SSM3515) initialised — the stock kernel driver
# doesn't, so speakers are silent. davidjo's patched cs8409 module does it, and it
# WORKS on the 2017 15" (MacBookPro14,3, verified on real hardware). BUT the AUR
# package's shipped dkms.conf has a path bug for kernel >= 6.17: that kernel moved
# the cs8409 source into `codecs/cirrus/`, so the built .ko lands at
# `build/hda/codecs/cirrus/snd-hda-codec-cs8409.ko`, while dkms.conf still points
# BUILT_MODULE_LOCATION at the old flat `build/hda`. Result: the module COMPILES
# fine but DKMS can't find it -> "Error! Build failed (location)" -> the module
# stays `added`, never `installed`, and the stock (silent) codec keeps loading.
# DevOS runs linux-lts (>= 6.17 always), so we just repoint it to codecs/cirrus.
#
# Everything else is the upstream AUR recipe. On a future davidjo/AUR update that
# fixes the path, drop this fork and go back to the plain AUR entry.
#
# Maintainer: Kye Hunter <kye(dot)evan(dot)hunter(at)gmail(dot)com>   (original AUR recipe)

pkgname=snd-hda-macbookpro-dkms-git
pkgver=0.1
pkgver() {
    sed -nr '/PACKAGE_VERSION/s/^.*="(.*)"$/\1/p' ${srcdir}/snd_hda_macbookpro/dkms.conf
}
pkgrel=3
pkgdesc="Kernel driver for sound on Macs with Cirrus 8409 HDA chips (DevOS: dkms.conf path fixed for kernel >=6.17)"
arch=(any)
url="https://github.com/davidjo/snd_hda_macbookpro"
license=('GPL-2.0-only')
install='snd_hda_macbookpro.install'
depends=(
    'git'
    'gcc'
    'make'
    'patch'
    'wget'
    'dkms'
)
makedepends=()
source=('git+https://github.com/davidjo/snd_hda_macbookpro.git')
sha256sums=('SKIP')

package() {
    for file in $(ls -p ${srcdir}/snd_hda_macbookpro | grep -v '/$') ; do
        install -D -m0644 -t \
            "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver} \
            ${srcdir}/snd_hda_macbookpro/"$file"
    done
    for file in $(ls -p ${srcdir}/snd_hda_macbookpro/makefiles | grep -v '/$') ; do
        install -D -m0644 -t \
            "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver}/makefiles \
            ${srcdir}/snd_hda_macbookpro/makefiles/"$file"
    done
    for file in $(ls -p ${srcdir}/snd_hda_macbookpro/patches | grep -v '/$') ; do
        install -D -m0644 -t \
            "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver}/patches \
            ${srcdir}/snd_hda_macbookpro/patches/"$file"
    done
    for file in $(ls -p ${srcdir}/snd_hda_macbookpro/patch_cirrus | grep -v '/$') ; do
        install -D -m0644 -t \
            "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver}/patch_cirrus \
            ${srcdir}/snd_hda_macbookpro/patch_cirrus/"$file"
    done
    install -D -m0755 -t \
        "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver} \
        "${srcdir}/snd_hda_macbookpro/install.cirrus.driver.sh"
    install -D -m0755 -t \
        "${pkgdir}"/usr/src/snd-hda-macbookpro-${pkgver} \
        "${srcdir}/snd_hda_macbookpro/install.cirrus.driver.pre617.sh"

    # DevOS fix: kernel >=6.17 builds the cs8409 .ko under codecs/cirrus/, but the
    # upstream dkms.conf points BUILT_MODULE_LOCATION at the old flat build/hda,
    # so DKMS can't locate the module and the install fails (module stays "added").
    # Verified on MacBookPro14,3 that this repoint makes it install + drive speakers.
    sed -i 's|BUILT_MODULE_LOCATION\[0\]="build/hda"|BUILT_MODULE_LOCATION[0]="build/hda/codecs/cirrus"|' \
        "${pkgdir}/usr/src/snd-hda-macbookpro-${pkgver}/dkms.conf"
}
