#!/usr/bin/env bash
# Privileged half of the camera toggle. Invoked AS ROOT via pkexec by cam-toggle,
# so it pops the graphical polkit password dialog (no sudoers rule needed).
case "${1:-}" in
    load)
        # bdc_pci grabs the same hardware and blocks /dev/video* creation
        modprobe -r bdc_pci 2>/dev/null || true
        modprobe facetimehd
        ;;
    unload)
        # runs as root via pkexec; force-kill anything holding the camera, then retry
        modprobe -r facetimehd 2>/dev/null && exit 0
        for a in 1 2 3; do
            fuser -k -KILL /dev/video0 2>/dev/null
            sleep 1
            modprobe -r facetimehd 2>/dev/null && exit 0
        done
        exit 1
        ;;
    *)
        echo "usage: cam-modprobe load|unload" >&2
        exit 2
        ;;
esac
