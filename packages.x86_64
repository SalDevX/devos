# --- Calamares runtime deps (KF6 — omitted from AUR PKGBUILD) ----------------
# calamares binary + modules link against these sonames but the PKGBUILD does
# not declare them; pacman will not pull them in automatically without this list.
# Verified via ldd on calamares-3.4.2-2-x86_64.pkg.tar.zst.
karchive
kconfig
kcrash
kpackage

# --- Display manager (SDDM macOS-style greeter) ------------------------------
# Login is SDDM with the in-tree devos Qt6 theme (airootfs/usr/share/sddm/themes
# /devos). Qt6 runtime comes in via calamares' KF6 deps above; the theme uses
# QtQuick.Effects (qt6-declarative). NOTE: Arch's Qt6 sddm daemon launches the
# Qt5 sddm-greeter by default — DevOS forces the Qt6 greeter via a pacman hook
# (airootfs/etc/pacman.d/hooks/zz-devos-sddm-qt6-greeter.hook) + customize_airootfs.
sddm

