#!/usr/bin/env bash
# DevOS first-boot: enable hardware-specific services on the REAL machine
# (this runs on the user's hardware, unlike customize_airootfs.sh which runs in
# the build chroot), then disable self. Idempotent via a stamp file.
set -eu

STAMP=/var/lib/devos/firstboot-done
[ -e "$STAMP" ] && exit 0
mkdir -p /var/lib/devos

# Give this machine its own pacman keyring. DevOS installs by cloning the live
# ISO, so /etc/pacman.d/gnupg is the keyring built in the ISO chroot (shared
# master key + a trust db that can leave NEW package installs failing PGP
# verification — "unknown trust" — even though `pacman -Syu` works, since the
# archlinux-keyring upgrade hook refreshes tracked keys). This is the Arch Wiki
# "reset all the keys" procedure. pacman-key reads /etc/pacman.conf for gpgdir,
# so guard on its presence; --populate is offline (reads the local
# archlinux-keyring package). No `pacman -Sy` here — that needs network, and a
# normal `pacman -Syu` already pulls keys added after the ISO was built.
# Runs once (firstboot stamp); wrapped so a failure can't block the rest.
if command -v pacman-key >/dev/null 2>&1 && [ -f /etc/pacman.conf ]; then
  rm -rf /etc/pacman.d/gnupg
  pacman-key --init && pacman-key --populate archlinux || true
fi

is_apple() { dmidecode -s system-manufacturer 2>/dev/null | grep -qi apple; }
is_intel() { grep -qi GenuineIntel /proc/cpuinfo 2>/dev/null; }

if is_apple; then
  systemctl enable --now \
    mbpfan.service \
    disable-apple-display-audio.service \
    disable-usb-autosuspend.service \
    lid-wakeup.service 2>/dev/null || true
fi

if is_intel; then
  systemctl enable --now thermald.service 2>/dev/null || true
fi

# Touch Bar (T1 iBridge, 2016/2017 MacBook Pro): usbmuxd grabs the iBridge USB
# before the HID driver and stops the Touch Bar from initialising. Mask it ONLY
# where the iBridge device is actually present (capability-gated, not model-gated —
# inert on every other machine). Tradeoff: iOS-over-USB stops on those models; the
# built-in Touch Bar wins. apple-ib-tb itself loads via modules-load.d (no-op when
# the device is absent), so nothing else here is conditional.
if grep -qil ibridge /sys/bus/usb/devices/*/product 2>/dev/null; then
  systemctl mask usbmuxd.service usbmuxd.socket 2>/dev/null || true
fi

# Sandbox ONLY Chromium with firejail. DevOS is a developer OS, so we deliberately
# do NOT run `firecfg` — it blanket-symlinks EVERY app that has a firejail profile
# (VS Code, editors, file managers, …) into the sandbox, which breaks them (the
# integrated terminal, debuggers, extensions, files outside $HOME, the `code` CLI).
# One symlink puts only `chromium` behind firejail: /usr/local/bin precedes
# /usr/bin in PATH, so `chromium` → firejail (loads chromium.profile) → the real
# /usr/bin/chromium, sandboxed. Brave stays native (it ships Chromium's own
# sandbox); every other app runs unsandboxed.
ln -sf /usr/bin/firejail /usr/local/bin/chromium

touch "$STAMP"
systemctl disable devos-firstboot.service 2>/dev/null || true
