#!/usr/bin/env bash
# devos-wifi-driver — select the correct Broadcom Wi-Fi driver for this Mac and
# blacklist the conflicting one, so the proprietary `wl` and the in-kernel
# `brcmfmac` never fight over the same PCI device.
#
# Decision key = the Wi-Fi chip's PCI device id (read straight from sysfs, no
# pciutils dependency) — the most reliable proxy for the MacBook series:
#
#   BCM4360 (0x43a0)  MacBookPro11,x       2013-2015  -> wl       (brcmfmac has no 4360 id)
#   BCM4364 (0x4464)  MacBookPro13,x/14,x  2016/2017  -> brcmfmac (wl has no 4364 id)
#   BCM4377 (0x4488)  T2 Macs              2018-2020  -> brcmfmac
#
# The two driver id-tables are disjoint, so this is belt-and-braces — but it
# makes the choice deterministic instead of relying on modalias load-order.
# Idempotent; safe no-op on non-Broadcom / unrecognised hardware.
set -eu

CONF=/etc/modprobe.d/devos-wifi.conf

# First Broadcom (vendor 0x14e4) PCI function on the bus.
dev=
for d in /sys/bus/pci/devices/*; do
    [ -r "$d/vendor" ] && [ -r "$d/device" ] || continue
    [ "$(cat "$d/vendor")" = 0x14e4 ] || continue
    dev=$(cat "$d/device")
    break
done

case "$dev" in
    0x43ba) want=brcmfmac; other=wl;       chip=     ;;  # BCM43602 — MacBookPro14,x (2017) etc.; firmware SHIPS in linux-firmware
    0x43a3) want=brcmfmac; other=wl;       chip=     ;;  # BCM4350  — some 2015-2017 Macs; firmware SHIPS in linux-firmware
    0x4464) want=brcmfmac; other=wl;       chip=4364 ;;  # BCM4364 — 2016 MBP13,x / T2-era; firmware NOT shipped (see devos-wifi-firmware)
    0x4488) want=brcmfmac; other=wl;       chip=4377 ;;  # BCM4377 — T2 Macs (2018-2020); firmware NOT shipped
    0x43a0) want=wl;       other=brcmfmac; chip=     ;;  # BCM4360 — MacBookPro11,x (2013-2015) → wl
    *)      exit 0 ;;                                    # unknown / non-Broadcom — leave kernel defaults
esac

# Persist the choice so the loser never auto-binds the device on later boots.
printf '# generated by devos-wifi-driver: Wi-Fi PCI id %s -> %s\nblacklist %s\n' \
       "$dev" "$want" "$other" > "$CONF"

modprobe -r "$other" 2>/dev/null || true
modprobe "$want"     2>/dev/null || true
echo "devos-wifi-driver: $dev -> loaded $want, blacklisted $other"

# brcmfmac needs Apple-board firmware + NVRAM that Arch's linux-firmware does NOT
# ship for BCM4364/4377. Warn loudly (journal) if it is missing — the driver
# loads but the card stays dark until the firmware + .txt NVRAM are installed.
if [ "$want" = brcmfmac ] && [ -n "$chip" ]; then
    if ! ls /lib/firmware/brcm/brcmfmac"$chip"*-pcie.bin >/dev/null 2>&1; then
        echo "devos-wifi-driver: WARNING brcmfmac selected for $dev (BCM$chip) but NO firmware" \
             "at /lib/firmware/brcm/brcmfmac$chip*-pcie.bin — Wi-Fi will NOT work until the" \
             "Apple firmware + NVRAM (.txt) are installed (extract from macOS or AUR)." >&2
    fi
fi
