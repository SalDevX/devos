#!/usr/bin/env bash
# macOS-style HUD for volume / display-brightness / keyboard-backlight via dunst.
# Usage: machud <target> [action]
#   target : volume | brightness | keyboard
#   action : up | down | mute | show   (default: show)
# Performs the change AND shows the segmented HUD, so it can be bound directly
# to media keys.
set -euo pipefail

ICONS="$HOME/.local/share/icons/machud"
SEG=16                  # number of segments in the macOS-style bar
STEP=5                  # volume/brightness step in %
KBD_STEP=10             # keyboard backlight step in %
KBD_DEV="smc::kbd_backlight"

# Build a SEG-wide segmented bar (▮ filled, ▯ empty) for a 0..100 value.
make_bar() {
    local v=$1 filled i bar=""
    filled=$(( (v * SEG + 50) / 100 ))
    (( filled > SEG )) && filled=$SEG
    (( filled < 0 ))   && filled=0
    for (( i = 0; i < SEG; i++ )); do
        if (( i < filled )); then bar+="▮"; else bar+="▯"; fi
    done
    printf '%s' "$bar"
}

# send <appname> <icon> <bar-text>
# Stack tag makes repeated presses replace the on-screen HUD instead of stacking.
send() {
    dunstify -a "$1" -i "$2" \
        -h "string:x-dunst-stack-tag:machud" \
        -h "string:x-canonical-private-synchronous:machud" \
        " " "$3"
}

target="${1:-}"
action="${2:-show}"

case "$target" in
    vol|volume)
        case "$action" in
            up)   pamixer --allow-boost false -i "$STEP" ;;
            down) pamixer -d "$STEP" ;;
            mute) pamixer -t ;;
        esac
        if [[ "$(pamixer --get-mute 2>/dev/null)" == "true" ]]; then
            send "volume" "$ICONS/volume-muted.svg" "$(make_bar 0)"
        else
            v=$(pamixer --get-volume)
            send "volume" "$ICONS/volume.svg" "$(make_bar "$v")"
        fi
        ;;
    bri|brightness)
        case "$action" in
            up)   brightnessctl set "${STEP}%+" >/dev/null ;;
            down) brightnessctl set "${STEP}%-" >/dev/null ;;
        esac
        v=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
        send "brightness" "$ICONS/brightness.svg" "$(make_bar "$v")"
        ;;
    kbd|keyboard)
        case "$action" in
            up)   brightnessctl -d "$KBD_DEV" set "${KBD_STEP}%+" >/dev/null ;;
            down) brightnessctl -d "$KBD_DEV" set "${KBD_STEP}%-" >/dev/null ;;
        esac
        v=$(brightnessctl -m -d "$KBD_DEV" | cut -d, -f4 | tr -d '%')
        send "kbd-brightness" "$ICONS/keyboard.svg" "$(make_bar "$v")"
        ;;
    *)
        echo "usage: machud {volume|brightness|keyboard} [up|down|mute|show]" >&2
        exit 1
        ;;
esac
