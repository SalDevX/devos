#!/usr/bin/env python3
"""
alacritty-theme — switch Alacritty colour theme with live tmux sync.

  alacritty-theme              interactive fzf picker with palette preview
  alacritty-theme tokyo-night  switch directly by name
  alacritty-theme --list       list themes, show active
  alacritty-theme --preview NAME  (called internally by fzf)
"""

import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

CONF = Path.home() / ".config/alacritty/alacritty.toml"
THEMES_DIR = Path.home() / ".config/alacritty/themes"
TMUX_LOCAL = Path.home() / ".tmux.conf.local"

PALETTE_ORDER = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


def list_themes() -> list[str]:
    return sorted(p.stem for p in THEMES_DIR.glob("*.toml"))


def current_theme() -> str | None:
    text = CONF.read_text()
    m = re.search(r'import\s*=\s*\["[^"]*themes/([^"]+)\.toml"\]', text)
    return m.group(1) if m else None


def load_theme_colors(name: str) -> dict[str, str]:
    path = THEMES_DIR / f"{name}.toml"
    with path.open("rb") as f:
        data = tomllib.load(f)
    colors = data.get("colors", {})
    return {
        "normal": colors.get("normal", {}),
        "bright": colors.get("bright", {}),
        "primary": colors.get("primary", {}),
    }


def theme_bg(name: str) -> str | None:
    try:
        return load_theme_colors(name)["primary"].get("background")
    except Exception:
        return None




def _tmux_running() -> bool:
    return subprocess.run(["tmux", "list-sessions"], capture_output=True).returncode == 0


def swatch(hex_color: str) -> str:
    r = int(hex_color[1:3], 16)
    g = int(hex_color[3:5], 16)
    b = int(hex_color[5:7], 16)
    return f"\033[48;2;{r};{g};{b}m   \033[0m"


def build_preview(name: str) -> str:
    try:
        c = load_theme_colors(name)
    except Exception:
        return f"  {name}\n  (could not parse theme)"

    normal = c["normal"]
    bright = c["bright"]

    def row(mapping: dict) -> str:
        return " ".join(swatch(mapping[k]) for k in PALETTE_ORDER if k in mapping)

    bg   = normal.get("black", "#000000")
    fg   = normal.get("white", "#ffffff")
    text = f"\033[38;2;{int(fg[1:3],16)};{int(fg[3:5],16)};{int(fg[5:7],16)}m"
    rst  = "\033[0m"

    lines = [
        "",
        f"  {text}{name}{rst}",
        "",
        f"  normal  {row(normal)}",
        f"  bright  {row(bright)}",
        "",
        f"  bg {normal.get('black','?')}   fg {normal.get('white','?')}",
    ]
    return "\n".join(lines)


def switch_theme(name: str) -> None:
    themes = list_themes()
    if name not in themes:
        print(f"no such theme: {name}", file=sys.stderr)
        print("available: " + ", ".join(themes), file=sys.stderr)
        sys.exit(1)

    text = CONF.read_text()
    new_text = re.sub(
        r'^import\s*=\s*\[.*\]$',
        f'import = ["~/.config/alacritty/themes/{name}.toml"]',
        text,
        flags=re.MULTILINE,
    )
    CONF.write_text(new_text)
    print(f"switched to: {name}")


def pick_with_fzf() -> str | None:
    themes = list_themes()
    cur = current_theme()
    preview_cmd = f"{sys.executable} {__file__} --preview {{}}"

    result = subprocess.run(
        [
            "fzf",
            "--ansi",
            "--preview", preview_cmd,
            "--preview-window", "right:45%:wrap",
            "--prompt", "theme > ",
            "--header", f"current: {cur or '<none>'}  |  enter to switch",
            "--height", "40%",
        ],
        input="\n".join(themes),
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def cmd_list() -> None:
    cur = current_theme()
    for t in list_themes():
        marker = "  ◀ active" if t == cur else ""
        print(f"  {t}{marker}")


if __name__ == "__main__":
    args = sys.argv[1:]

    if not args:
        chosen = pick_with_fzf()
        if chosen:
            switch_theme(chosen)

    elif args[0] == "--preview" and len(args) == 2:
        print(build_preview(args[1]))

    elif args[0] in ("--list", "-l"):
        cmd_list()

    else:
        switch_theme(args[0])
