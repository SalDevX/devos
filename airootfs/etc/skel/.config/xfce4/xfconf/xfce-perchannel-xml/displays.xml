<?xml version="1.1" encoding="UTF-8"?>

<!-- No hardcoded display profile. The pizza machine's eDP1/DP2 EDID hashes,
     resolutions and positions were captured here, which forced a stale layout
     onto every other MacBook (wrong connector name -> profile never matched ->
     wallpaper/scaling silently wrong). With no Default profile, xfce4-display
     auto-configures each connected monitor at its native mode. Per-machine
     tweaks belong in ~/.config/devos/display.sh, not a burned-in profile. -->
<channel name="displays" version="1.0">
  <property name="Notify" type="int" value="3"/>
  <property name="IdentityPopups" type="bool" value="false"/>
</channel>
